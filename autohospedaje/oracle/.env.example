# Copia como .env y completa. NUNCA lo subas a GitHub (ya esta en .gitignore).
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Dominio  (OBLIGATORIO)
# ---------------------------------------------------------------------------
# Debe tener un registro A apuntando a la IP publica de tu instancia Oracle.
# Sin dominio no hay HTTPS automatico, y Telegram exige HTTPS para el webhook.
N8N_DOMINIO=n8n.tudominio.cl

# ---------------------------------------------------------------------------
# PostgreSQL  (OBLIGATORIO)
# ---------------------------------------------------------------------------
# Genera la contrasena con:  openssl rand -base64 24
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Clave de cifrado de credenciales  (OBLIGATORIA)
# ---------------------------------------------------------------------------
# Genera con:  openssl rand -hex 32
# Guardala en tu gestor de contrasenas. Sin ella, un respaldo de la base no
# te sirve para recuperar las 5 credenciales.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Tu chat de Telegram  (OBLIGATORIO)
# ---------------------------------------------------------------------------
# El numero de result[0].message.chat.id en
#   https://api.telegram.org/bot<TU_TOKEN>/getUpdates
BIBLIO_TELEGRAM_CHAT_ID=
