# Copia como .env y completa.  cp .env.example .env
# NUNCA lo subas a GitHub (ya esta cubierto por .gitignore).

# ---------------------------------------------------------------------------
# Dominio  (OBLIGATORIO)
# ---------------------------------------------------------------------------
# El hostname publico que configuraste en Cloudflare Zero Trust.
# NO es la IP de tu casa: con el tunel, tu IP nunca se expone.
N8N_DOMINIO=n8n.tudominio.cl

# ---------------------------------------------------------------------------
# Token del tunel de Cloudflare  (OBLIGATORIO)
# ---------------------------------------------------------------------------
# Te lo entrega Cloudflare al crear el tunel.
# Zero Trust -> Networks -> Tunnels -> Create tunnel -> Cloudflared
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# PostgreSQL  (OBLIGATORIO)
# ---------------------------------------------------------------------------
# Genera con:  openssl rand -base64 24
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Clave de cifrado de credenciales  (OBLIGATORIA)
# ---------------------------------------------------------------------------
# Genera con:  openssl rand -hex 32
# Guardala TAMBIEN en tu gestor de contrasenas: sin ella, un respaldo de la
# base de datos no te devuelve las 5 credenciales.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Tu chat de Telegram  (OBLIGATORIO)
# ---------------------------------------------------------------------------
# result[0].message.chat.id en https://api.telegram.org/bot<TOKEN>/getUpdates
BIBLIO_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Tu correo para Crossref  (opcional, pero recomendado)
# ---------------------------------------------------------------------------
# Crossref pide que las aplicaciones se identifiquen con un correo. A cambio te
# da acceso a su "polite pool", que responde mas rapido y de forma mas estable.
# Si lo dejas vacio funciona igual, solo que por la via publica.
CROSSREF_MAILTO=
