# Copia este archivo como .env (sin el .example) y completa los valores.
#
#   cp .env.example .env
#
# NUNCA subas el .env a GitHub. Ya esta cubierto por .gitignore.

# ---------------------------------------------------------------------------
# Clave de cifrado de credenciales  (OBLIGATORIA)
# ---------------------------------------------------------------------------
# Generala una sola vez y guardala en tu gestor de contrasenas:
#
#   openssl rand -hex 32
#
# Si la cambias despues, las credenciales ya guardadas quedan ilegibles.
# Si la conservas, puedes mover el volumen del notebook a la Raspberry y las
# 5 credenciales siguen funcionando sin rehacerlas.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Tu chat de Telegram  (OBLIGATORIA)
# ---------------------------------------------------------------------------
# El numero que sale en result[0].message.chat.id al abrir
#   https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# despues de escribirle algo a tu bot.
#
# El flujo solo responde a este chat. Si queda vacio, no pasa nadie.
BIBLIO_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# URL publica  (OBLIGATORIA para que funcione el bot)
# ---------------------------------------------------------------------------
# Telegram necesita alcanzar tu n8n desde internet. Elige UNA opcion:
#
# A) NOTEBOOK, tunel temporal para probar
#    Levanta el tunel aparte y pega aca la URL que imprime al arrancar.
#    OJO: esa URL CAMBIA cada vez que reinicias el tunel, y cada vez hay que
#    volver a pegarla aca y reactivar el workflow para que Telegram vuelva a
#    registrar el webhook. Sirve para probar, no para dejarlo corriendo.
#
# B) RASPBERRY (o notebook fijo), Cloudflare Tunnel con dominio propio
#    URL estable, HTTPS incluido, funciona detras de CGNAT y no abre puertos.
#    Ejemplo: https://n8n.tudominio.cl
#
WEBHOOK_URL=

# Deben ser coherentes con WEBHOOK_URL.
# Solo localhost:      N8N_HOST=localhost      N8N_PROTOCOL=http
# Con dominio propio:  N8N_HOST=n8n.tudominio.cl   N8N_PROTOCOL=https
N8N_HOST=localhost
N8N_PROTOCOL=http
